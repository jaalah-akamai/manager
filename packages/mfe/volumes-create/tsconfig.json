{
  "compilerOptions": {
    "jsx": "react",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "src/*": ["src/*"]
    }
  },
  "include": ["src"]
}